---
import GithubMark from "./GithubMark.astro";
import { APP_URL, REPO_URL } from "../site";

const base = import.meta.env.BASE_URL;
const links = [
  { href: "#features", label: "Features" },
  { href: "#how-it-works", label: "How it works" },
  { href: "#get-started", label: "Get started" },
];
---

<header class="sticky top-0 z-30 border-b bg-background/80 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href={base} class="flex items-center gap-2.5 font-semibold">
      <img src={`${base}favicon.svg`} alt="" width="28" height="28" class="rounded-md" />
      Makerstorage
    </a>
    <nav aria-label="Main" class="hidden items-center gap-6 text-sm text-muted-foreground md:flex">
      {links.map((link) => <a href={link.href} class="transition-colors hover:text-foreground">{link.label}</a>)}
    </nav>
    <div class="flex items-center gap-2">
      <a
        href={`${APP_URL}/login`}
        class="inline-flex h-9 items-center rounded-md px-3 text-sm font-medium transition-colors hover:bg-muted"
      >
        Sign in
      </a>
      <a
        href={REPO_URL}
        class="inline-flex h-9 items-center gap-2 rounded-md border bg-card px-3 text-sm font-medium shadow-xs transition-colors hover:bg-muted"
        aria-label="GitHub"
      >
        <GithubMark class="size-4" />
        <span class="hidden sm:inline">GitHub</span>
      </a>
    </div>
  </div>
</header>
