<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <title>Makerstorage</title>
  </head>

  <body style="margin: 0; padding: 0; width: 100%; background-color: #f4f4f5; -webkit-font-smoothing: antialiased; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f4f4f5;">
      <tr>
        <td align="center" style="padding: 32px 16px;">
          <table role="presentation" width="560" cellpadding="0" cellspacing="0" border="0" style="width: 560px; max-width: 100%; margin: 0 auto;">

            <!-- Header / brand -->
            <tr>
              <td style="padding: 4px 8px 20px 8px;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td style="width: 36px; height: 36px; vertical-align: middle;"><%= image_tag attachments["logo.png"].url, alt: "Makerstorage", width: 36, height: 36, style: "display: block; width: 36px; height: 36px; border-radius: 8px;" %></td>
                    <td style="padding-left: 10px; font-size: 18px; font-weight: 600; letter-spacing: -0.01em; color: #09090b;">Makerstorage</td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Card -->
            <tr>
              <td style="background-color: #ffffff; border: 1px solid #e4e4e7; border-radius: 12px; padding: 32px;">
                <div style="font-size: 15px; line-height: 1.6; color: #3f3f46;">
                  <%= yield %>
                </div>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style="padding: 24px 8px 8px 8px; font-size: 12px; line-height: 1.6; color: #a1a1aa;">
                <p style="margin: 0 0 4px 0;">Makerstorage &middot; Electronics-parts inventory for makerspaces.</p>
                <p style="margin: 0;">You received this email because an account action was requested. If it wasn&#39;t you, you can safely ignore this message.</p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
