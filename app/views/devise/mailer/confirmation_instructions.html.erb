<% confirm_url = user_confirmation_url(confirmation_token: @token) %>
<h1 style="margin: 0 0 16px 0; font-size: 18px; font-weight: 600; color: #09090b;"><%= t("mail.confirmation.title") %></h1>

<p style="margin: 0 0 16px 0;"><%= t("mail.hello", name: @email) %></p>

<p style="margin: 0 0 16px 0;"><%= t("mail.confirmation.body") %></p>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 24px 0;">
  <tr>
    <td style="border-radius: 8px; background-color: #facc15;">
      <a href="<%= confirm_url %>" style="display: inline-block; padding: 12px 22px; font-size: 14px; font-weight: 600; color: #1c1917; text-decoration: none;"><%= t("mail.confirmation.button") %></a>
    </td>
  </tr>
</table>

<p style="margin: 0 0 16px 0; font-size: 13px; color: #71717a;">
  <%= t("mail.confirmation.expires", count: (Devise.confirm_within / 86_400).to_i) %> <%= t("mail.copy_url") %><br>
  <a href="<%= confirm_url %>" style="color: #71717a; word-break: break-all;"><%= confirm_url %></a>
</p>

<p style="margin: 16px 0 0 0;"><%= t("mail.confirmation.ignore") %></p>
