<% changed_to = @resource.try(:unconfirmed_email?) ? @resource.unconfirmed_email : @resource.email %>
<h1 style="margin: 0 0 16px 0; font-size: 18px; font-weight: 600; color: #09090b;"><%= t("mail.email_changed.title") %></h1>

<p style="margin: 0 0 16px 0;"><%= t("mail.hello", name: @email) %></p>

<p style="margin: 0 0 16px 0;"><%= t(@resource.try(:unconfirmed_email?) ? "mail.email_changed.being_changed_html" : "mail.email_changed.changed_html", email: changed_to) %></p>

<p style="margin: 0;"><%= t("mail.email_changed.not_you") %></p>
