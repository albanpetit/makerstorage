<% reset_url = edit_user_password_url(reset_password_token: @token) %>
<h1 style="margin: 0 0 16px 0; font-size: 18px; font-weight: 600; color: #09090b;">Reset your password</h1>

<p style="margin: 0 0 16px 0;">Hello <%= @resource.email %>,</p>

<p style="margin: 0 0 16px 0;">Someone requested a link to change the password on your Makerstorage account. Click the button below to choose a new one.</p>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 24px 0;">
  <tr>
    <td style="border-radius: 8px; background-color: #facc15;">
      <a href="<%= reset_url %>" style="display: inline-block; padding: 12px 22px; font-size: 14px; font-weight: 600; color: #1c1917; text-decoration: none;">Reset password</a>
    </td>
  </tr>
</table>

<p style="margin: 0 0 16px 0; font-size: 13px; color: #71717a;">
  This link expires in <%= (Devise.reset_password_within / 3600).to_i %> hours. If the button doesn&#39;t work, copy and paste this URL into your browser:<br>
  <a href="<%= reset_url %>" style="color: #71717a; word-break: break-all;"><%= reset_url %></a>
</p>

<p style="margin: 16px 0 0 0;">If you didn&#39;t request this, you can safely ignore this email &mdash; your password won&#39;t change until you open the link above and set a new one.</p>
