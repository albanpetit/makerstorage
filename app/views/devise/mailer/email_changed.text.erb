<%= t("mail.email_changed.title") %>

<%= t("mail.hello", name: @email) %>

<% if @resource.try(:unconfirmed_email?) -%>
<%= t("mail.email_changed.being_changed", email: @resource.unconfirmed_email) %>
<% else -%>
<%= t("mail.email_changed.changed", email: @resource.email) %>
<% end -%>

<%= t("mail.email_changed.not_you") %>
