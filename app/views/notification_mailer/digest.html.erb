<% content_for :mailer_footer do %>
  You receive this digest as a member of <%= @organization.name %>. Turn it off from your <a href="<%= profile_url %>" style="color: #a1a1aa;">profile</a>; admins choose which alerts are sent in Settings &rarr; Notifications.
<% end %>
<h1 style="margin: 0 0 16px 0; font-size: 18px; font-weight: 600; color: #09090b;"><%= @organization.name %> alerts</h1>

<p style="margin: 0 0 16px 0;">Hello <%= @user.firstname.presence || @user.email %>, here is what needs attention as of <%= l(@digest.date, format: :long) %>.</p>

<% if @digest.low_stock.any? %>
  <h2 style="margin: 24px 0 8px 0; font-size: 15px; font-weight: 600; color: #09090b;">Low stock (<%= @digest.low_stock.size %>)</h2>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size: 14px; border-collapse: collapse;">
    <% @digest.low_stock.first(NotificationDigest::LIMIT).each do |item| %>
      <tr>
        <td style="padding: 6px 0; border-bottom: 1px solid #e4e4e7;">
          <span style="color: #09090b;"><%= item.name %></span>
          <% if item.code.present? %><span style="color: #71717a; font-family: monospace;"> <%= item.code %></span><% end %>
        </td>
        <td align="right" style="padding: 6px 0; border-bottom: 1px solid #e4e4e7; white-space: nowrap; color: <%= item.quantity.zero? ? '#dc2626' : '#3f3f46' %>;"><%= item.quantity %> / <%= item.threshold %></td>
      </tr>
    <% end %>
  </table>
  <% if @digest.low_stock.size > NotificationDigest::LIMIT %>
    <p style="margin: 8px 0 0 0; font-size: 13px; color: #71717a;">And <%= @digest.low_stock.size - NotificationDigest::LIMIT %> more.</p>
  <% end %>
<% end %>

<% if @digest.late_orders.any? %>
  <h2 style="margin: 24px 0 8px 0; font-size: 15px; font-weight: 600; color: #09090b;">Late orders (<%= @digest.late_orders.size %>)</h2>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size: 14px; border-collapse: collapse;">
    <% @digest.late_orders.first(NotificationDigest::LIMIT).each do |item| %>
      <tr>
        <td style="padding: 6px 0; border-bottom: 1px solid #e4e4e7;">
          <span style="color: #09090b;"><%= item.reference.presence || "Order ##{item.order_id}" %></span>
          <span style="color: #71717a;"> &middot; <%= item.supplier_name %></span>
        </td>
        <td align="right" style="padding: 6px 0; border-bottom: 1px solid #e4e4e7; white-space: nowrap; color: #dc2626;">
          <%= pluralize(item.days_late, "day") %> late
        </td>
      </tr>
    <% end %>
  </table>
  <% if @digest.late_orders.size > NotificationDigest::LIMIT %>
    <p style="margin: 8px 0 0 0; font-size: 13px; color: #71717a;">And <%= @digest.late_orders.size - NotificationDigest::LIMIT %> more.</p>
  <% end %>
<% end %>

<% if @digest.overdue_loans.any? %>
  <h2 style="margin: 24px 0 8px 0; font-size: 15px; font-weight: 600; color: #09090b;">Overdue loans (<%= @digest.overdue_loans.size %>)</h2>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size: 14px; border-collapse: collapse;">
    <% @digest.overdue_loans.first(NotificationDigest::LIMIT).each do |item| %>
      <tr>
        <td style="padding: 6px 0; border-bottom: 1px solid #e4e4e7;">
          <a href="<%= loan_url(item.loan_id, organization_id: @organization.id) %>" style="color: #09090b; text-decoration: none;"><%= item.reference.presence || "Loan ##{item.loan_id}" %></a>
          <span style="color: #71717a;"> &middot; <%= item.borrower_name %> &middot; <%= pluralize(item.outstanding, "item") %></span>
        </td>
        <td align="right" style="padding: 6px 0; border-bottom: 1px solid #e4e4e7; white-space: nowrap; color: #dc2626;">
          <%= pluralize(item.days_late, "day") %> late
        </td>
      </tr>
    <% end %>
  </table>
  <% if @digest.overdue_loans.size > NotificationDigest::LIMIT %>
    <p style="margin: 8px 0 0 0; font-size: 13px; color: #71717a;">And <%= @digest.overdue_loans.size - NotificationDigest::LIMIT %> more.</p>
  <% end %>
<% end %>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 24px 0 0 0;">
  <tr>
    <td style="border-radius: 8px; background-color: #facc15;">
      <a href="<%= alerts_url(organization_id: @organization.id) %>" style="display: inline-block; padding: 12px 22px; font-size: 14px; font-weight: 600; color: #1c1917; text-decoration: none;">Open alerts</a>
    </td>
  </tr>
</table>
