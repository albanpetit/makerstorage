<% content_for :mailer_footer do %>
  <%= t("mail.digest.footer_html", organization: @organization.name, profile: link_to(t("mail.digest.profile"), profile_url, style: "color: #a1a1aa;")) %>
<% end %>
<h1 style="margin: 0 0 16px 0; font-size: 18px; font-weight: 600; color: #09090b;"><%= t("mail.digest.title", organization: @organization.name) %></h1>

<p style="margin: 0 0 16px 0;"><%= t("mail.digest.intro", name: @user.firstname.presence || @user.email, date: l(@digest.date, format: :long)) %></p>

<% if @digest.low_stock.any? %>
  <h2 style="margin: 24px 0 8px 0; font-size: 15px; font-weight: 600; color: #09090b;"><%= t("mail.digest.low_stock", count: @digest.low_stock.size) %></h2>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size: 14px; border-collapse: collapse;">
    <% @digest.low_stock.first(NotificationDigest::LIMIT).each do |item| %>
      <tr>
        <td style="padding: 6px 0; border-bottom: 1px solid #e4e4e7;">
          <span style="color: #09090b;"><%= item.name %></span>
          <% if item.code.present? %><span style="color: #71717a; font-family: monospace;"> <%= item.code %></span><% end %>
        </td>
        <td align="right" style="padding: 6px 0; border-bottom: 1px solid #e4e4e7; white-space: nowrap; color: <%= item.quantity.zero? ? '#dc2626' : '#3f3f46' %>;"><%= item.quantity %> / <%= item.threshold %></td>
      </tr>
    <% end %>
  </table>
  <% if @digest.low_stock.size > NotificationDigest::LIMIT %>
    <p style="margin: 8px 0 0 0; font-size: 13px; color: #71717a;"><%= t("mail.digest.more", count: @digest.low_stock.size - NotificationDigest::LIMIT) %></p>
  <% end %>
<% end %>

<% if @digest.late_orders.any? %>
  <h2 style="margin: 24px 0 8px 0; font-size: 15px; font-weight: 600; color: #09090b;"><%= t("mail.digest.late_orders", count: @digest.late_orders.size) %></h2>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size: 14px; border-collapse: collapse;">
    <% @digest.late_orders.first(NotificationDigest::LIMIT).each do |item| %>
      <tr>
        <td style="padding: 6px 0; border-bottom: 1px solid #e4e4e7;">
          <span style="color: #09090b;"><%= item.reference.presence || t("mail.digest.order", id: item.order_id) %></span>
          <span style="color: #71717a;"> &middot; <%= item.supplier_name %></span>
        </td>
        <td align="right" style="padding: 6px 0; border-bottom: 1px solid #e4e4e7; white-space: nowrap; color: #dc2626;">
          <%= t("mail.digest.days_late", count: item.days_late) %>
        </td>
      </tr>
    <% end %>
  </table>
  <% if @digest.late_orders.size > NotificationDigest::LIMIT %>
    <p style="margin: 8px 0 0 0; font-size: 13px; color: #71717a;"><%= t("mail.digest.more", count: @digest.late_orders.size - NotificationDigest::LIMIT) %></p>
  <% end %>
<% end %>

<% if @digest.overdue_loans.any? %>
  <h2 style="margin: 24px 0 8px 0; font-size: 15px; font-weight: 600; color: #09090b;"><%= t("mail.digest.overdue_loans", count: @digest.overdue_loans.size) %></h2>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size: 14px; border-collapse: collapse;">
    <% @digest.overdue_loans.first(NotificationDigest::LIMIT).each do |item| %>
      <tr>
        <td style="padding: 6px 0; border-bottom: 1px solid #e4e4e7;">
          <a href="<%= loan_url(item.loan_id, organization_id: @organization.id) %>" style="color: #09090b; text-decoration: none;"><%= item.reference.presence || t("mail.digest.loan", id: item.loan_id) %></a>
          <span style="color: #71717a;"> &middot; <%= item.borrower_name %> &middot; <%= t("mail.digest.items", count: item.outstanding) %></span>
        </td>
        <td align="right" style="padding: 6px 0; border-bottom: 1px solid #e4e4e7; white-space: nowrap; color: #dc2626;">
          <%= t("mail.digest.days_late", count: item.days_late) %>
        </td>
      </tr>
    <% end %>
  </table>
  <% if @digest.overdue_loans.size > NotificationDigest::LIMIT %>
    <p style="margin: 8px 0 0 0; font-size: 13px; color: #71717a;"><%= t("mail.digest.more", count: @digest.overdue_loans.size - NotificationDigest::LIMIT) %></p>
  <% end %>
<% end %>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 24px 0 0 0;">
  <tr>
    <td style="border-radius: 8px; background-color: #facc15;">
      <a href="<%= alerts_url(organization_id: @organization.id) %>" style="display: inline-block; padding: 12px 22px; font-size: 14px; font-weight: 600; color: #1c1917; text-decoration: none;"><%= t("mail.digest.open_alerts") %></a>
    </td>
  </tr>
</table>
