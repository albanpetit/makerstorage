<% content_for :mailer_footer do %>
You receive this digest as a member of <%= @organization.name %>.
Turn it off from your profile: <%= profile_url %>
<% end -%>
<%= @organization.name %> alerts

Hello <%= @user.firstname.presence || @user.email %>, here is what needs
attention as of <%= l(@digest.date, format: :long) %>.
<% if @digest.low_stock.any? %>

Low stock (<%= @digest.low_stock.size %>)
<% @digest.low_stock.first(NotificationDigest::LIMIT).each do |item| -%>
- <%= item.name %><%= " (#{item.code})" if item.code.present? %>: <%= item.quantity %> / <%= item.threshold %>
<% end -%>
<% if @digest.low_stock.size > NotificationDigest::LIMIT -%>
And <%= @digest.low_stock.size - NotificationDigest::LIMIT %> more.
<% end -%>
<% end -%>
<% if @digest.late_orders.any? %>

Late orders (<%= @digest.late_orders.size %>)
<% @digest.late_orders.first(NotificationDigest::LIMIT).each do |item| -%>
- <%= item.reference.presence || "Order ##{item.order_id}" %> (<%= item.supplier_name %>): <%= pluralize(item.days_late, "day") %> late
<% end -%>
<% if @digest.late_orders.size > NotificationDigest::LIMIT -%>
And <%= @digest.late_orders.size - NotificationDigest::LIMIT %> more.
<% end -%>
<% end -%>
<% if @digest.overdue_loans.any? %>

Overdue loans (<%= @digest.overdue_loans.size %>)
<% @digest.overdue_loans.first(NotificationDigest::LIMIT).each do |item| -%>
- <%= item.reference.presence || "Loan ##{item.loan_id}" %> (<%= item.borrower_name %>, <%= pluralize(item.outstanding, "item") %>): <%= pluralize(item.days_late, "day") %> late
<% end -%>
<% if @digest.overdue_loans.size > NotificationDigest::LIMIT -%>
And <%= @digest.overdue_loans.size - NotificationDigest::LIMIT %> more.
<% end -%>
<% end -%>

Open alerts: <%= alerts_url(organization_id: @organization.id) %>
