# Secrets referenced by config/deploy.yml (registry/password and env/secret).
# All values are pulled from ENV or a local file — DO NOT ENTER RAW CREDENTIALS
# HERE. This file is committed, so it must stay safe for git.
#
# In CI, the deploy workflow exports KAMAL_REGISTRY_PASSWORD and RAILS_MASTER_KEY
# into the environment. Locally, both fall back to sensible sources so `bin/kamal
# deploy` works from a dev machine too.

# ghcr.io registry password — a GitHub PAT with write:packages/read:packages. The
# automatic GITHUB_TOKEN is deliberately NOT used: ghcr denies it for user-namespace
# packages (ghcr.io/albanpetit/…). CI passes the PAT as KAMAL_REGISTRY_PASSWORD;
# locally we fall back to the `gh` CLI token (which must carry packages scope).
KAMAL_REGISTRY_PASSWORD=${KAMAL_REGISTRY_PASSWORD:-$(gh config get -h github.com oauth_token 2>/dev/null)}

# Rails master key. CI provides RAILS_MASTER_KEY; locally we read config/master.key.
# Never check config/master.key into git!
RAILS_MASTER_KEY=${RAILS_MASTER_KEY:-$(cat config/master.key 2>/dev/null)}
