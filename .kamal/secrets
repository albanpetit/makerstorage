# Secrets referenced by config/deploy.yml (registry/password and env/secret).
# All values are pulled from ENV or a local file — DO NOT ENTER RAW CREDENTIALS
# HERE. This file is committed, so it must stay safe for git.
#
# In CI, the deploy workflow exports GITHUB_TOKEN and RAILS_MASTER_KEY into the
# environment. Locally, both fall back to sensible sources so `bin/kamal deploy`
# works from a dev machine too.

# ghcr.io registry password. CI provides GITHUB_TOKEN; locally we fall back to the
# token stored by the `gh` CLI (needs read:packages/write:packages scope).
GITHUB_TOKEN=${GITHUB_TOKEN:-$(gh config get -h github.com oauth_token 2>/dev/null)}

# Rails master key. CI provides RAILS_MASTER_KEY; locally we read config/master.key.
# Never check config/master.key into git!
RAILS_MASTER_KEY=${RAILS_MASTER_KEY:-$(cat config/master.key 2>/dev/null)}
