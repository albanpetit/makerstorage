# Secrets referenced by config/deploy.yml (registry/password and env/secret).
# Values come straight from the environment — DO NOT put raw credentials here; this
# file is committed and must stay safe for git.
#
# IMPORTANT: Kamal reads this file with Dotenv, which does NOT understand bash
# operators like ${VAR:-default} — using one silently appends the literal ":-…}" to
# the value and corrupts the secret. Only plain $VAR expansion and $(command)
# substitution are supported, so keep these as simple pass-throughs.
#
# CI: the deploy workflow sets KAMAL_REGISTRY_PASSWORD and RAILS_MASTER_KEY.
# Local: export them first, e.g.
#   export KAMAL_REGISTRY_PASSWORD=<ghcr PAT with write:packages>
#   export RAILS_MASTER_KEY=$(cat config/master.key)

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RAILS_MASTER_KEY=$RAILS_MASTER_KEY
